        print(" / / / / __ \\/ ___/ _ \\/ /")
        print("/ /_/ / /_/ / /  /  __/ / ")
        print("\\____/\\____/_/   \\___/_/  ")
        print(f"{cls.RESET}")
        print(f"{cls.BOLD}{APP_NAME} GitHub Repository Builder v{APP_VERSION}{cls.RESET}")
        print()


