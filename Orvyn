class UI:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    GREEN = "\033[92m"
    RED = "\033[91m"
    YELLOW = "\033[93m"
    BLUE = "\033[94m"
    CYAN = "\033[96m"

    @classmethod
    def info(cls, message: str) -> None:
        print(f"{cls.BLUE}[*]{cls.RESET} {message}")

    @classmethod
    def success(cls, message: str) -> None:
        print(f"{cls.GREEN}[+]{cls.RESET} {message}")

    @classmethod
    def warning(cls, message: str) -> None:
        print(f"{cls.YELLOW}[!]{cls.RESET} {message}")

    @classmethod
    def error(cls, message: str) -> None:
        print(f"{cls.RED}[x]{cls.RESET} {message}")

    @classmethod
    def title(cls) -> None:
        print()
        print(f"{cls.CYAN}{cls.BOLD}")
        print("   ____                     ")
